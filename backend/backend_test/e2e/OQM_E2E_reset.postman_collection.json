		{
			"name": "03 - Reset the services",
			"description": "Story: as an admin, I restart the ticket numbering (e.g. at the start of a new day).",
			"item": [
				{
					"name": "14. Admin resets the services",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const services = pm.response.json();",
									"",
									"pm.test(\"Every service has 0 tickets\", () => {",
									"    services.forEach(s => pm.expect(s.num_tickets).to.eql(0));",
									"});",
									"",
									"pm.test(\"Payment, Delivery and Assembling are in the list\", () => {",
									"    const ids = services.map(s => s.id);",
									"    [\"paymentId\", \"deliveryId\", \"assemblingId\"].forEach(v => {",
									"        pm.expect(ids).to.include(Number(pm.collectionVariables.get(v)));",
									"    });",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/services/reset",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"services",
								"reset"
							]
						}
					}
				}
			]
		},
